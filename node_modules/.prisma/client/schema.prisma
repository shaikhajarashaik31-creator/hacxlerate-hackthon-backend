// Prisma Schema for EduPulse AI on Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   Int      @id @default(autoincrement())
  name                 String
  email                String   @unique
  password_hash        String
  role                 String // 'student', 'teacher', 'admin'
  department           String?
  skills               String?
  interests            String?
  must_change_password Int      @default(0)
  created_at           DateTime @default(now())

  // Relations
  login_logs          LoginLog[]
  taught_courses      Course[]             @relation("TeacherCourses")
  attendances         Attendance[]
  performances        Performance[]
  performance_history PerformanceHistory[]
  enrollments         Enrollment[]
  coins               Coin[]
  certificates        Certificate[]
  feedbacks_given     Feedback[]           @relation("StudentFeedback")
  feedbacks_received  Feedback[]           @relation("TeacherFeedback")
  activity_logs       ActivityLog[]
  test_attempts       TestAttempt[]
  projects            Project[]
  resumes             Resume[]
  chat_sessions       ChatSession[]
  chat_histories      ChatHistory[]
  submissions         Submission[]

  @@map("users")
}

model LoginLog {
  id          Int       @id @default(autoincrement())
  user_id     Int
  login_time  DateTime  @default(now())
  logout_time DateTime?
  ip          String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("login_logs")
}

model Course {
  id            Int     @id @default(autoincrement())
  title         String
  description   String?
  category      String?
  teacher_id    Int?
  coin_cost     Int     @default(0)
  is_extra      Int     @default(0)
  total_lessons Int     @default(10)

  teacher      User?         @relation("TeacherCourses", fields: [teacher_id], references: [id], onDelete: SetNull)
  attendances  Attendance[]
  performances Performance[]
  enrollments  Enrollment[]
  certificates Certificate[]
  feedbacks    Feedback[]
  class_notes  ClassNote[]
  tests        Test[]

  @@map("courses")
}

model Attendance {
  id         Int      @id @default(autoincrement())
  student_id Int
  course_id  Int
  class_date DateTime @db.Date
  status     String // 'present', 'absent'

  student User   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("attendance")
}

model Performance {
  id         Int      @id @default(autoincrement())
  student_id Int
  course_id  Int
  score      Float
  updated_at DateTime @default(now())

  student User   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("performance")
}

model PerformanceHistory {
  id              Int      @id @default(autoincrement())
  student_id      Int
  score           Float
  test_part       Float
  coding_part     Float
  course_part     Float
  attendance_part Float
  created_at      DateTime @default(now())

  student User @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("performance_history")
}

model Enrollment {
  id               Int       @id @default(autoincrement())
  student_id       Int
  course_id        Int
  progress_percent Int       @default(0)
  status           String    @default("in_progress") // 'in_progress', 'completed'
  enrolled_at      DateTime  @default(now())
  completed_at     DateTime?

  student User   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([student_id, course_id])
  @@map("enrollments")
}

model Coin {
  id         Int      @id @default(autoincrement())
  student_id Int
  amount     Int
  reason     String
  created_at DateTime @default(now())

  student User @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("coins")
}

model Certificate {
  id               Int      @id @default(autoincrement())
  student_id       Int
  course_id        Int
  certificate_code String   @unique
  issued_at        DateTime @default(now())

  student User   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model Feedback {
  id         Int      @id @default(autoincrement())
  student_id Int
  teacher_id Int
  course_id  Int
  rating     Int
  comment    String
  created_at DateTime @default(now())

  student User   @relation("StudentFeedback", fields: [student_id], references: [id], onDelete: Cascade)
  teacher User   @relation("TeacherFeedback", fields: [teacher_id], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model ClassNote {
  id          Int      @id @default(autoincrement())
  course_id   Int
  class_date  DateTime @db.Date
  title       String
  content     String
  page_number Int      @default(1)
  is_revised  Int      @default(0)
  svg_diagram String?
  created_at  DateTime @default(now())

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("class_notes")
}

model ActivityLog {
  id               Int      @id @default(autoincrement())
  user_id          Int
  page             String?
  course_id        Int?
  test_id          Int?
  event_type       String // 'page_view', 'course_time', 'test_time'
  duration_seconds Int      @default(0)
  created_at       DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model Test {
  id               Int    @id @default(autoincrement())
  title            String
  course_id        Int?
  duration_minutes Int    @default(15)
  type             String @default("mock_test") // 'mock_test', 'mock_interview'

  course    Course?       @relation(fields: [course_id], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  TestAttempt[]

  @@map("tests")
}

model Question {
  id             Int    @id @default(autoincrement())
  test_id        Int
  question       String
  option_a       String
  option_b       String
  option_c       String
  option_d       String
  correct_option String

  test Test @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@map("questions")
}

model TestAttempt {
  id                 Int      @id @default(autoincrement())
  student_id         Int
  test_id            Int
  score              Float
  time_taken_seconds Int
  taken_at           DateTime @default(now())

  student User @relation(fields: [student_id], references: [id], onDelete: Cascade)
  test    Test @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@map("test_attempts")
}

model Project {
  id          Int      @id @default(autoincrement())
  student_id  Int
  title       String
  description String?
  language    String
  code        String
  updated_at  DateTime @default(now())

  student User @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Resume {
  id           Int      @id @default(autoincrement())
  student_id   Int
  content_json String
  ats_score    Int      @default(0)
  updated_at   DateTime @default(now())

  student User @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model ChatSession {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  created_at DateTime @default(now())

  user     User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages ChatHistory[]

  @@map("chat_sessions")
}

model ChatHistory {
  id         Int      @id @default(autoincrement())
  session_id Int?
  user_id    Int
  role       String // 'user', 'model'
  message    String
  created_at DateTime @default(now())

  session ChatSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("chat_history")
}

model Submission {
  id         Int      @id @default(autoincrement())
  student_id Int
  problem_id Int
  language   String
  code       String
  status     String
  passed     Int      @default(0)
  total      Int      @default(0)
  created_at DateTime @default(now())

  student User @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("submissions")
}
